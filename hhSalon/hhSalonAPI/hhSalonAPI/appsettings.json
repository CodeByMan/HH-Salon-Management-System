{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "hhSalonAPI",
    "Audience": "hhSalonClient",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 5
  },
  "PayPal": {
    "Environment": "Sandbox",
    "Currency": "USD"
  },
  "Diagnostics": {
    "EnableSensitiveDataLogging": false
  },
  "Database": {
    "SeedOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200"
    ]
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 465
  },
  "BootstrapAdmin": {
    "Enabled": false
  }
}
